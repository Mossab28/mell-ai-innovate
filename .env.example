PORT=8787
# postgres://... en prod ; un chemin de dossier pour PGlite en local ; vide = base en mémoire
DATABASE_URL=./.data/pglite
MELLA_ADMIN_TOKEN=change-moi
# Lignes iMessage : id|numéro|secret;...
MELLA_SEED_LINES=mac1|+33600000000|un-long-secret-aleatoire

AWS_PROFILE=gpu
MELLA_LLM=bedrock
MELLA_BEDROCK_REGION=eu-west-3
# MELLA_MODEL_ROUTER=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# MELLA_MODEL_QUICK=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# MELLA_MODEL_TOOL=eu.anthropic.claude-sonnet-4-6
# MELLA_MODEL_TASK=eu.anthropic.claude-sonnet-4-6
# MELLA_MODEL_BATCH=eu.anthropic.claude-sonnet-4-6
# La veille (Mell écrit en premier, 7 h 45, 12 h 30, 18 h 30 heure locale) : MELLA_PULSE=0 la coupe.
# MELLA_MODEL_PULSE=eu.anthropic.claude-sonnet-4-6
# Un ID nu (claude-haiku-5-5) passe par l'API Anthropic directe, hors d'AWS Europe ; la clé reste hors dépôt.
# MELLA_MODEL_QUICK=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# MELLA_ROUTER_MIN_CONFIDENCE=0.6
# MELLA_ACK_AFTER_MS=6000
# MELLA_DEBOUNCE_MS=1500

# Base des liens envoyés dans le fil (saisie au coffre /v/, connexion Google /connect/)
MELLA_PUBLIC_URL=http://localhost:8787
# Client OAuth Google (Gmail + Agenda), type « Application Web », URL de retour ${MELLA_PUBLIC_URL}/connect/google/callback.
# Vides : le serveur les lit au coffre (mella-kv/data/server/google-oauth, clés client_id et client_secret) ;
# introuvables nulle part, la connexion Google est simplement indisponible et le serveur démarre quand même.
# MELLA_GOOGLE_CLIENT_ID=
# MELLA_GOOGLE_CLIENT_SECRET=
# Réception SMTP existante et adresse de réponse propre à chaque personne.
# MELLA_MAIL_DOMAINS=askmell.com
# MELLA_MAIL_PORT=2525
# MELLA_MAIL_HOSTNAME=mx.askmell.com
# Envoi Azure Communication Services Email : domaine vérifié et lié à la ressource ACS.
# L'expéditeur reste fixe ; Reply-To est l'adresse Mell de la personne. Sans ces deux valeurs, pas d'envoi.
# Garder la chaîne de connexion dans l'environnement serveur, jamais dans le dépôt ou les logs.
# MELLA_MAIL_FROM=mell@askmell.com
# MELLA_AZURE_EMAIL_CONNECTION_STRING=
# Coffre OpenBao sur PwnAI, via infra/vault/tunnel.sh ; infra/vault/token.sh donne ces trois lignes.
# Sans MELLA_VAULT_ADDR : coffre en mémoire, perdu à l'arrêt.
# MELLA_VAULT=openbao
# MELLA_VAULT_ADDR=http://127.0.0.1:8200
# MELLA_VAULT_TOKEN=

# Navigateur des tâches web (voir infra/browser/README.md). Moteur open source auto-hébergé.
# MELLA_BROWSER_ENGINE=patchright
# Hôte distant par tunnel SSH (infra/browser/tunnel.sh) ; vide = Chrome lancé sur cette machine.
# MELLA_BROWSER_WS=ws://127.0.0.1:9451/mella
# Secours quand un anti-robot refuse Chrome : Camoufox (Firefox patché). none = pas de secours.
# MELLA_BROWSER_FALLBACK=camoufox
# MELLA_BROWSER_FALLBACK_WS=ws://127.0.0.1:9454/mella
# Clé des profils web chiffrés (openssl rand -base64 32) ; vide = profils perdus au redémarrage.
# MELLA_BROWSER_KEY=

# Vocaux transcrits sur cette machine (whisper.cpp, `brew install whisper-cpp`). Sans modèle, Mell dit qu'il n'a pas pu écouter.
# MELLA_WHISPER_BIN=whisper-cli
# MELLA_WHISPER_MODEL=/opt/models/ggml-large-v3-turbo-q5_0.bin

# Accès sur invitation (comme Instinct) : sans code valable, la personne attend sur la liste ; POST /admin/admit la fait entrer.
# MELLA_INVITE_ONLY=1
# MELLA_INVITES_PER_USER=5

# Photo des cartes de lieux (restos, bars, hôtels) quand leur page la refuse : Google Places (New), clé limitée à Places.
MELLA_GOOGLE_PLACES_KEY=

# Recherche web : anthropic (défaut avec une clé) ou searxng (notre SearXNG, pour le modèle ouvert).
MELLA_SEARCH=
# Le Claude qui fait la recherche anthropic (défaut : celui de Mell si Claude, sinon claude-haiku-5-5).
MELLA_SEARCH_MODEL=
MELLA_SEARXNG_URL=http://127.0.0.1:8888
